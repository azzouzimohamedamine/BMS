# Raw CALCE data: redistribution licence not verified -> never commit
data/raw/CALCE/*
!data/raw/CALCE/.gitkeep
data/processed/*
!data/processed/.gitkeep
# Kaggle ageing datasets: licence not verified -> never commit
data/raw/KAGGLE/*
!data/raw/KAGGLE/.gitkeep
# Python / tooling
__pycache__/
*.pyc
.pytest_cache/
.venv/
*.egg-info/
# LaTeX build files
report/*.aux
report/*.log
report/*.out
report/*.toc
report/*.bbl
report/*.blg
report/*.fls
report/*.fdb_latexmk
# Model binaries are regenerated by scripts/run_all.py
models/*.joblib
models/*.npz
